{
  "name": "oucs-engine",
  "version": "1.0.0",
  "description": "Open Universal Container for Sound — JavaScript bindings for liboucs",
  "main": "src/index.js",
  "exports": {
    ".": {
      "node": "./src/index.js",
      "browser": "./src/browser.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "build:wasm": "emcc ../../src/*.c -I../../include -O2 -s WASM=1 -s MODULARIZE=1 -s EXPORT_NAME=OucsModule -s ALLOW_MEMORY_GROWTH=1 -lm -o dist/oucs.js",
    "test": "node tests/test_oucs.js"
  },
  "keywords": [
    "audio",
    "music",
    "container",
    "streaming",
    "oucs",
    "mp3",
    "flac",
    "wav",
    "ogg",
    "wasm",
    "open-source"
  ],
  "author": "ParthHariom",
  "license": "MIT",
  "homepage": "https://github.com/ParthHariom/oucs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParthHariom/oucs.git"
  },
  "bugs": {
    "url": "https://github.com/ParthHariom/oucs/issues"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@parthhariom/oucs": "^1.0.0",
    "oucs-engine": "^1.0.0"
  }
}
